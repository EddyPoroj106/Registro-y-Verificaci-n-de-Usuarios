# Copia este archivo como ".env" y llena tus datos reales.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

PORT=3000
BASE_URL=http://localhost:3000

# Configuración SMTP para enviar correos reales.
# Ejemplo usando Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=xxxxxxxxxxxxxxxx   <- Contraseña de aplicación (no tu contraseña normal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
